# =====================================================
# Waybar Monitor Configuration
# =====================================================
# Copy this file to monitors.env and configure for your hardware:
#   cp monitors.env.example monitors.env
#
# To check your monitor names:
#   hyprctl monitors
# =====================================================

# =====================================================
# Display Configuration
# =====================================================

# Main monitor (required)
# Examples: DP-3, DP-6, HDMI-A-1, eDP-1
# Check your monitor with: hyprctl monitors
MONITOR_MAIN=DP-1

# Sub monitor (optional - leave empty for single display)
# Examples: HDMI-A-1, HDMI-A-2, DP-2
# For single display: leave empty (recommended default)
# For dual display: set to second monitor name
MONITOR_SUB=""

# =====================================================
# Workspace Assignment
# =====================================================
# Single display: All workspaces (1-10) on MONITOR_MAIN
# Dual display:   Workspaces 1-5 on MONITOR_MAIN
#                 Workspaces 6-10 on MONITOR_SUB
# =====================================================
