{
  // ============================================================
  // グローバル設定
  // ============================================================
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 0,

  // ============================================================
  // モジュール配置
  // ============================================================
  "modules-left": [
    "custom/launcher",         // アプリランチャー
    "hyprland/workspaces",     // ワークスペース一覧
    "hyprland/submap",         // サブマップ表示
    "wlr/taskbar",             // タスクバー
    "hyprland/window"          // ウィンドウタイトル
  ],
  "modules-center": [
    "mpris",                   // メディアプレイヤー情報
    "clock"                    // 時計・カレンダー
  ],
  "modules-right": [
    "custom/updates",          // システムアップデート
    "idle_inhibitor",          // アイドル抑制（カフェインモード）
    "pulseaudio",              // 音量コントロール
    "bluetooth",               // Bluetooth
    "network",                 // ネットワーク
    "cpu",                     // CPU使用率
    "memory",                  // メモリ使用率
    "backlight",               // 画面輝度
    "battery",                 // バッテリー
    "tray",                    // システムトレイ
    "custom/power"             // 電源メニュー
  ],

  // ============================================================
  // 左側モジュール設定
  // ============================================================
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "",
      "default": "",
      "empty": "",
      "urgent": ""
    },
    "on-click": "activate",
    "persistent-workspaces": {
      "DP-3": [
        1,
        2,
        3,
        4,
        5
      ],
      "HDMI-A-1": [
        6,
        7,
        8,
        9,
        10
      ]
    },
    "all-outputs": false,
    "show-special": false
  },
  "hyprland/window": {
    "format": "{}",
    "max-length": 50,
    "separate-outputs": true,
    "icon": true,
    "icon-size": 16,
    "tooltip": true,
    "tooltip-format": "{title}",
    "rewrite": {
      "(.*) — Mozilla Firefox": "🌐 $1",
      "(.*) - Visual Studio Code": " $1",
      "(.*) - Chromium": "🌐 $1",
      "(.*) - ghostty": " $1"
    }
  },
  "hyprland/submap": {
    "format": "<span style=\"italic\">  {}</span>",
    "tooltip": false
  },
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 18,
    "icon-theme": "Papirus-Dark",
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close",
    "ignore-list": [],
    "app_ids-mapping": {
      "firefoxdeveloperedition": "firefox-developer-edition"
    }
  },
  "custom/launcher": {
    "format": "",
    "on-click": "fuzzel",
    "tooltip": false
  },

  // ============================================================
  // 中央モジュール設定
  // ============================================================
  "clock": {
    "timezone": "Asia/Tokyo",
    "format": "\uf017 {:%Y-%m-%d %H:%M}",
    "format-alt": "\uf017 {:%Y年%m月%d日 %H:%M}",
    "tooltip-format": "<big>{:%Y年 %B}</big>\n<tt><small>{calendar}</small></tt>",
    "on-click": "gnome-calendar",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#89b4fa'><b>{}</b></span>",
        "days": "<span color='#cdd6f4'><b>{}</b></span>",
        "weeks": "<span color='#a6e3a1'><b>W{}</b></span>",
        "weekdays": "<span color='#f9e2af'><b>{}</b></span>",
        "today": "<span color='#f38ba8'><b><u>{}</u></b></span>"
      }
    }
  },

  // ============================================================
  // 右側モジュール設定
  // ============================================================
  "cpu": {
    "format": "\uf4bc {usage}%",
    "format-alt": " {avg_frequency}GHz",
    "tooltip-format": "使用率: {usage}%\n平均周波数: {avg_frequency}GHz\nコア別:\n{load}",
    "interval": 2,
    "on-click": "ghostty -e btop"
  },
  "memory": {
    "format": "\uefc5 {percentage}%",
    "format-alt": " {used:0.1f}G/{total:0.1f}G",
    "tooltip-format": "使用中: {used:0.2f}GB / {total:0.2f}GB\n使用率: {percentage}%\nスワップ: {swapUsed:0.2f}GB / {swapTotal:0.2f}GB ({swapPercentage}%)",
    "interval": 2,
    "on-click": "ghostty -e btop"
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon} {percent}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      ""
    ],
    "on-scroll-up": "brightnessctl set 5%+",
    "on-scroll-down": "brightnessctl set 5%-"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-alt": "{icon} {time}",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ]
  },
  "network": {
    "format-wifi": "\uf1eb",
    "format-ethernet": "\udb80\ude01",
    "format-disconnected": "\udb80\udf19",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}\nゲートウェイ: {gwaddr}\n信号強度: {signalStrength}%\nSSID: {essid}\n速度: ↓{bandwidthDownBits} ↑{bandwidthUpBits}",
    "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}\nゲートウェイ: {gwaddr}\n速度: ↓{bandwidthDownBits} ↑{bandwidthUpBits}",
    "tooltip-format-disconnected": "ネットワーク接続なし",
    "interval": 2,
    "on-click": "nm-connection-editor",
    "on-click-right": "ghostty -e nmtui"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "\udb81\udf5f Muted",
    "format-bluetooth": "{icon} {volume}%",
    "format-bluetooth-muted": " {icon} Muted",
    "format-source": " {volume}%",
    "format-source-muted": "",
    "format-icons": {
      "headphone": "󰋋",
      "headset": "󰋎",
      "phone": "󰏲",
      "default": [
        "󰓃",
        "󰓃",
        "󰓃"
      ]
    },
    "tooltip-format": "{desc}\n音量: {volume}%",
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  },
  "tray": {
    "icon-size": 21,
    "spacing": 10
  },
  "bluetooth": {
    "format": "\udb80\udcb2",
    "format-connected": "\udb80\udcaf",
    "format-connected-battery": " {device_alias} {device_battery_percentage}%",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
    "on-click": "overskride"
  },
  "custom/updates": {
    "format": "󱧕 {}",
    "interval": 3600,
    "exec": "(checkupdates; yay -Qua) 2>/dev/null | wc -l || echo 0",
    "exec-if": "exit 0",
    "on-click": "ghostty -e yay -Syu",
    "tooltip-format": "Available updates: {}"
  },
  "custom/power": {
    "format": "⏻",
    "on-click": "wlogout",
    "tooltip": "電源メニュー"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰒲"
    },
    "tooltip-format-activated": "カフェインモード: ON\n自動スリープ無効化中",
    "tooltip-format-deactivated": "カフェインモード: OFF\n自動スリープ有効",
    "on-click-right": "hyprctl dispatch dpms toggle"
  },
  "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon} <i>{dynamic}</i>",
    "player-icons": {
      "default": "🎵",
      "spotify": "",
      "firefox": "",
      "chromium": ""
    },
    "status-icons": {
      "playing": "▶",
      "paused": "⏸"
    },
    "dynamic-order": [
      "title",
      "artist"
    ],
    "dynamic-separator": " - ",
    "dynamic-len": 50,
    "tooltip-format": "{player}\n{title}\n{artist}\n{album}",
    "ignored-players": [],
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-click-middle": "playerctl previous",
    "on-scroll-up": "playerctl volume 0.05+",
    "on-scroll-down": "playerctl volume 0.05-"
  }
}
