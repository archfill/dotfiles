# Ghostty Linux-Specific Configuration
# このファイルはLinuxでのみ読み込まれます

# ==========================================
# Linux Font Settings
# ==========================================
font-size = 10

# ==========================================
# Linux Key Bindings - Basic
# ==========================================
# Linuxではcmdキーがないためctrlキーを使用
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+t=new_tab
keybind = ctrl+w=close_surface
keybind = ctrl+n=new_window
keybind = ctrl+shift+n=new_window
keybind = ctrl+comma=open_config

# ==========================================
# Linux Key Bindings - Enhanced
# ==========================================
# 設定リロード
keybind = ctrl+shift+comma=reload_config
# 分割ペイン
keybind = ctrl+d=new_split:right
keybind = ctrl+shift+d=new_split:down
# vim風ペイン移動
keybind = ctrl+h=goto_split:left
keybind = ctrl+j=goto_split:down
keybind = ctrl+k=goto_split:up
keybind = ctrl+l=goto_split:right
# vim風ペインリサイズ
keybind = ctrl+shift+h=resize_split:left,5
keybind = ctrl+shift+j=resize_split:down,5
keybind = ctrl+shift+k=resize_split:up,5
keybind = ctrl+shift+l=resize_split:right,5
# タブ移動
keybind = ctrl+shift+left=previous_tab
keybind = ctrl+shift+right=next_tab
# 数字キーでタブ切り替え
keybind = ctrl+one=goto_tab:1
keybind = ctrl+two=goto_tab:2
keybind = ctrl+three=goto_tab:3
keybind = ctrl+four=goto_tab:4
keybind = ctrl+five=goto_tab:5
keybind = ctrl+six=goto_tab:6
keybind = ctrl+seven=goto_tab:7
keybind = ctrl+eight=goto_tab:8
keybind = ctrl+nine=goto_tab:9
# タブオーバービュー（タブが多い時に便利）
keybind = ctrl+shift+o=toggle_tab_overview

# ==========================================
# Linux Performance Optimization
# ==========================================
# 同一プロセスでウィンドウを開く（起動時間とメモリ使用量を大幅削減）
gtk-single-instance = true

# ==========================================
# Linux Quick Terminal
# ==========================================
# クイックターミナル機能（グローバルキーバインド）
# Linuxではsuper(Windows)キーを使用
keybind = global:super+grave_accent=toggle_quick_terminal
