# Ghostty Terminal Configuration
# https://github.com/ghostty-org/ghostty
#
# このファイルは共通設定を含み、プラットフォーム固有の設定は
# 別ファイルから読み込みます。

# ==========================================
# Font Configuration
# ==========================================
# HackGen35 Console NF（3:5比率版、英数字大きめ）+ フォールバック
font-family = "HackGen35 Console NF"
font-family = "JetBrainsMono Nerd Font"
font-family = "Noto Sans CJK JP"
# Console版は十分太いのでthickenは無効化
font-thicken = false
# リガチャを無効化（多くのユーザーが設定）
font-feature = -liga

# ==========================================
# Theme Configuration
# ==========================================
# 人気のCatppuccinテーマに変更（ライト/ダーク自動切り替え）
theme = light:Catppuccin Latte,dark:Catppuccin Mocha

# ==========================================
# Window Configuration
# ==========================================
window-decoration = true
background-opacity = 0.95
window-theme = "system"
# ウィンドウサイズの設定（文字数ベース）
window-height = 30
window-width = 110
# ウィンドウの状態を保存
window-save-state = always
# パディングのバランス調整
window-padding-balance = true
# セルの高さを調整してより見やすく
adjust-cell-height = 35%

# ==========================================
# Cursor Configuration
# ==========================================
cursor-style = "block"
cursor-style-blink = false
# カーソルの色をより目立つように
cursor-color = "#61afef"

# ==========================================
# Split Panes
# ==========================================
unfocused-split-opacity = 0.7

# ==========================================
# Shell Integration
# ==========================================
# tmux廃止済みのため、Shell Integrationを有効化
shell-integration = zsh
# 機能: カーソル変更、sudo環境変数保持、タブタイトル自動更新
shell-integration-features = cursor,sudo,title

# OSC 52クリップボードサポート（SSH/リモート作業用）
clipboard-read = allow
clipboard-write = allow
# コピー設定の最適化
clipboard-paste-protection = true
clipboard-trim-trailing-spaces = true
right-click-action = copy-or-paste
# コピーノーティフィケーション無効化（Linuxのみ）
app-notifications = no-clipboard-copy

# ==========================================
# Performance Settings
# ==========================================
# スクロールバックバッファの最適化
scrollback-limit = 100000
# 画像プロトコルのサポート（kitty互換）
image-storage-limit = 320000000

# ==========================================
# True Color Support
# ==========================================
# tmux連携のため明示的にTERM変数を設定
term = xterm-256color

# ==========================================
# Mouse Configuration
# ==========================================
mouse-hide-while-typing = true
# スクロール速度を向上
mouse-scroll-multiplier = 2

# ==========================================
# Common Key Bindings
# ==========================================
# 改行の追加（便利）
keybind = shift+enter=text:\n
# フォントサイズ調整（よく使われる）
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size

# ==========================================
# Selection and Colors
# ==========================================
# 選択範囲の色をより見やすく
selection-background = "#3e4451"
selection-foreground = "#abb2bf"

# ==========================================
# Additional Recommended Settings
# ==========================================
# ウィンドウタイトルのカスタマイズ
# 固定タイトルを無効化（Shell Integrationで動的タイトルを使用）
# title = "Ghostty Terminal"
window-title-font-family = "HackGen35 Console NF"

# より高度なシェル統合（tmux使用者向け）
# 専用スクリプトでtmuxセッションを管理
# このスクリプトはAlacrittyとも共有
# 注: ghosttyはチルダ(~)を展開しないため、環境変数を使用
# tmux自動起動を無効化（Ghosttyネイティブ使用のため）
# command = ${HOME}/.config/scripts/tmux-session.sh

# ==========================================
# Optional: Custom Shaders
# ==========================================
# より高度なビジュアル効果が必要な場合
# custom-shader = "shaders/bloom025.glsl"

# ==========================================
# Platform-Specific Configuration
# ==========================================
# プラットフォーム固有の設定を読み込み
# シンボリックリンク 'platform' を使用:
#   Linux: platform -> linux
#   macOS: platform -> macos
# リンクの作成は bin/link.sh で自動的に行われます
config-file = platform

# ==========================================
# Notes
# ==========================================
# 設定の変更後は Super+Shift+, でリロードするか、
# ターミナルを再起動してください。
#
# 利用可能なテーマ一覧: ghostty +list-themes
# 設定オプション確認: ghostty +show-config --default --docs