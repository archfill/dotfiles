# Ghostty Terminal Configuration
# https://github.com/ghostty-org/ghostty
#
# このファイルは共通設定を含み、プラットフォーム固有の設定は
# 別ファイルから読み込みます。

# ==========================================
# Font Configuration
# ==========================================
# HackGen Console NFをメインフォントに設定（ターミナル作業最適化）
font-family = "HackGen Console NF"
font-family = "JetBrains Mono"
font-size = 14
# Console NFは十分太いのでthickenは無効化
font-thicken = false
# リガチャを無効化（多くのユーザーが設定）
font-feature = -liga

# ==========================================
# Theme Configuration
# ==========================================
# 人気のCatppuccinテーマに変更（ライト/ダーク自動切り替え）
theme = light:Catppuccin Latte,dark:Catppuccin Mocha

# ==========================================
# Window Configuration
# ==========================================
window-decoration = true
background-opacity = 0.95
window-theme = "system"
# ウィンドウサイズの設定（文字数ベース）
window-height = 30
window-width = 110
# ウィンドウの状態を保存
window-save-state = always
# パディングのバランス調整
window-padding-balance = true
# セルの高さを調整してより見やすく
adjust-cell-height = 35%

# ==========================================
# Cursor Configuration
# ==========================================
cursor-style = "block"
cursor-style-blink = false
# カーソルの色をより目立つように
cursor-color = "#61afef"

# ==========================================
# Split Panes
# ==========================================
unfocused-split-opacity = 0.7

# ==========================================
# Shell Integration
# ==========================================
shell-integration = zsh
# より安全で人気の設定
shell-integration-features = "no-cursor,sudo,no-title"

# ==========================================
# Performance Settings
# ==========================================
# スクロールバックバッファの最適化
scrollback-limit = 100000

# ==========================================
# Mouse Configuration
# ==========================================
mouse-hide-while-typing = true
# スクロール速度を向上
mouse-scroll-multiplier = 2

# ==========================================
# Common Key Bindings
# ==========================================
# 改行の追加（便利）
keybind = shift+enter=text:\n

# ==========================================
# Selection and Colors
# ==========================================
# 選択範囲の色をより見やすく
selection-background = "#3e4451"
selection-foreground = "#abb2bf"

# ==========================================
# Additional Recommended Settings
# ==========================================
# ウィンドウタイトルのカスタマイズ
title = "Ghostty Terminal"
window-title-font-family = "HackGen Console NF"

# より高度なシェル統合（tmux使用者向け）
# command = zsh --login -c "if command -v tmux >/dev/null 2>&1; then tmux attach || tmux; else zsh; fi"

# ==========================================
# Optional: Custom Shaders
# ==========================================
# より高度なビジュアル効果が必要な場合
# custom-shader = "shaders/bloom025.glsl"

# ==========================================
# Platform-Specific Configuration
# ==========================================
# プラットフォーム固有の設定を読み込み（存在する場合のみ）
# macOS: .config/ghostty/macos
# Linux: .config/ghostty/linux
config-file = ?macos
config-file = ?linux

# ==========================================
# Notes
# ==========================================
# 設定の変更後は Super+Shift+, でリロードするか、
# ターミナルを再起動してください。
#
# 利用可能なテーマ一覧: ghostty +list-themes
# 設定オプション確認: ghostty +show-config --default --docs