# Ghostty Terminal Configuration
# https://github.com/ghostty-org/ghostty

# Font Configuration
font-family = "UDEV Gothic 35NFLG"
font-size = 14

# Theme
theme = "One Dark"

# Window Configuration
window-decoration = true
window-opacity = 0.95
window-theme = "system"

# Cursor
cursor-style = "block"
cursor-style-blink = false

# Japanese Input Support
macos-titlebar-style = "native"
unfocused-split-opacity = 0.7

# Shell Integration
shell-integration = true
shell-integration-features = "cursor,sudo,title"

# Performance
sync-to-monitor = true

# Mouse
mouse-hide-while-typing = true

# Key Bindings
keybind = super+shift+c=copy_to_clipboard
keybind = super+shift+v=paste_from_clipboard
keybind = super+t=new_tab
keybind = super+w=close_surface
keybind = super+n=new_window
keybind = super+shift+n=new_window
keybind = super+comma=open_config

# Tab Configuration
tab-width = 8