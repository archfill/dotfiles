/* ============================================================
   Rofi Cheatsheet Theme
   ============================================================
   Differentiated from app launcher with:
   - Tertiary color accent (pink/magenta)
   - Wider layout for keybind + description
   - Monospace alignment
   - Bottom anchor position
   ============================================================ */

@import "colors.rasi"

* {
    font: "JetBrainsMono Nerd Font Propo 11";
    background-color: transparent;
    text-color: @on-surface;
}

window {
    width: 700px;
    transparency: "real";
    background-color: @surface;
    border: 2px solid;
    border-color: @tertiary;
    border-radius: 12px;
    padding: 16px;
    location: center;
    anchor: center;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
    spacing: 12px;
}

inputbar {
    background-color: @surface-container;
    border-radius: 8px;
    padding: 10px 14px;
    children: [ prompt, entry ];
    spacing: 10px;
}

prompt {
    background-color: transparent;
    text-color: @tertiary;
    font: "JetBrainsMono Nerd Font Propo Bold 11";
}

entry {
    background-color: transparent;
    text-color: @on-surface;
    placeholder: "Filter keybinds...";
    placeholder-color: @outline;
}

listview {
    background-color: transparent;
    lines: 16;
    columns: 1;
    fixed-height: true;
    spacing: 2px;
    scrollbar: false;
}

element {
    background-color: transparent;
    padding: 6px 12px;
    border-radius: 6px;
    spacing: 8px;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @on-surface;
}

element selected.normal {
    background-color: @tertiary-container;
    text-color: @on-tertiary-container;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

/* Category headers (lines starting with ===) */
element normal.active,
element alternate.active {
    background-color: transparent;
    text-color: @tertiary;
}

element selected.active {
    background-color: @tertiary-container;
    text-color: @on-tertiary-container;
}

scrollbar {
    width: 0px;
}
