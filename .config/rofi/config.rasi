/* ============================================================
   Rofi Configuration
   ============================================================
   Colors: Material You (generated by matugen)
   ============================================================ */

configuration {
    modi: "drun,run,window,emoji,calc";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    terminal: "ghostty";
    drun-display-format: "{name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    display-drun: "󰀻";
    display-run: "󰆍";
    display-window: "󰖲";
    display-emoji: "󰞅";
    display-calc: "󰃬";
    sidebar-mode: true;
    kb-mode-next: "Shift+Down,Control+Tab";
    kb-mode-previous: "Shift+Up,Control+Shift+Tab";
}

@import "colors.rasi"

* {
    font: "JetBrainsMono Nerd Font Propo 12";
    background-color: transparent;
    text-color: @on-surface;
}

window {
    width: 600px;
    transparency: "real";
    background-color: @surface;
    border: 2px solid;
    border-color: @primary;
    border-radius: 16px;
    padding: 20px;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, content ];
    spacing: 16px;
}

content {
    background-color: transparent;
    orientation: horizontal;
    children: [ mode-switcher, listview ];
    spacing: 16px;
}

inputbar {
    background-color: @surface-container;
    border-radius: 12px;
    padding: 12px 16px;
    children: [ prompt, entry ];
    spacing: 12px;
}

prompt {
    background-color: transparent;
    text-color: @primary;
    font: "JetBrainsMono Nerd Font Propo Bold 12";
}

entry {
    background-color: transparent;
    text-color: @on-surface;
    placeholder: "Search...";
    placeholder-color: @outline;
}

listview {
    background-color: transparent;
    lines: 8;
    columns: 1;
    fixed-height: true;
    spacing: 4px;
    scrollbar: false;
}

element {
    background-color: transparent;
    padding: 10px 16px;
    border-radius: 10px;
    spacing: 12px;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @on-surface;
}

element selected.normal {
    background-color: @primary;
    text-color: @on-primary;
}

element-icon {
    size: 24px;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

mode-switcher {
    background-color: @surface-container;
    border-radius: 12px;
    padding: 8px;
    spacing: 8px;
    orientation: vertical;
}

button {
    background-color: transparent;
    text-color: @on-surface-variant;
    padding: 12px;
    border-radius: 8px;
    font: "JetBrainsMono Nerd Font Propo 16";
}

button selected {
    background-color: @primary-container;
    text-color: @on-primary-container;
}

message {
    background-color: @surface-container;
    border-radius: 12px;
    padding: 12px;
}

textbox {
    background-color: transparent;
    text-color: @on-surface;
}
