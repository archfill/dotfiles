[include]
	path = ~/.config/git/config.local

[init]
	defaultBranch = main

[core]
	editor = nvim
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	light = false

[ghq]
	# root は環境固有のため ~/.config/git/config.local に bin/config.sh が書き込む
	shallow = true

[ghq "look"]
	depth = 1

[alias]
	tree = log --graph --pretty=format:'%x09%C(auto) %h %Cgreen %ar %Creset%x09by\"%C(cyan ul)%an%Creset\" %x09%C(auto)%s %d'
