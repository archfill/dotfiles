[include]
	path = ~/.config/git/config.local

[init]
	defaultBranch = main

[core]
	editor = nvim
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	light = false

[ghq]
	# root は環境固有のため ~/.config/git/config.local に bin/config.sh が書き込む
	shallow = true

[ghq "look"]
	depth = 1

[alias]
	tree = log --graph --pretty=format:'%x09%C(auto) %h %Cgreen %ar %Creset%x09by\"%C(cyan ul)%an%Creset\" %x09%C(auto)%s %d'

# Cursor Origin の git 認証。store path 直書きは `make origin-update` + GC で
# 壊れるため PATH 参照 (`!origin ...`) で固定。`origin auth login` が書き直した
# 場合は package 側ラッパー (nix/pkgs/origin) が自動でこの形へ正規化する。
[credential "https://origin.cursor.com/git"]
	helper = 
	helper = !origin credential-helper
[credential "https://origin.cursor.com"]
	helper = 
	helper = !origin credential-helper
# GitHub CLI の Git 認証は Nix store の絶対パスではなく PATH で解決する。
# `gh auth login/setup-git` が書き直した場合は Nix 管理 wrapper が正規化する。
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
