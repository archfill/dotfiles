# =====================================================
# Monitor Configuration (Environment-specific)
# =====================================================
# This file is auto-generated during installation and not tracked by git
# Copy this file to monitors.conf and edit according to your hardware
#
# Usage:
#   cp ~/.config/hypr/monitors.conf.example ~/.config/hypr/monitors.conf
#   vim ~/.config/hypr/monitors.conf
#
# To check your monitor configuration:
#   hyprctl monitors
# =====================================================

# =====================================================
# Default: Single Monitor Setup
# =====================================================
# Edit the monitor name to match your hardware

# Monitor configuration
# Syntax: monitor=NAME,RESOLUTION@REFRESH,POSITION,SCALE
monitor=DP-1,preferred,auto,1

# Start the session on this monitor
cursor {
    default_monitor = DP-1
}

# Workspace assignment (optional for single monitor)
# All workspaces will default to the single monitor
# Uncomment to explicitly assign:
# workspace=1,monitor:DP-1
# workspace=2,monitor:DP-1
# workspace=3,monitor:DP-1
# workspace=4,monitor:DP-1
# workspace=5,monitor:DP-1
# workspace=6,monitor:DP-1
# workspace=7,monitor:DP-1
# workspace=8,monitor:DP-1
# workspace=9,monitor:DP-1
# workspace=10,monitor:DP-1

# =====================================================
# Common Monitor Names (for reference)
# =====================================================
# Desktop:
#   - HDMI-A-1, HDMI-A-2
#   - DP-1, DP-2, DP-3, DP-4, DP-5, DP-6
#
# Laptop:
#   - eDP-1 (internal display)
#
# Use 'hyprctl monitors' to find your exact monitor name
# =====================================================

# =====================================================
# Resolution Options (for reference)
# =====================================================
# Common resolutions:
#   - 1920x1080@60   (Full HD, 60Hz)
#   - 2560x1440@144  (QHD, 144Hz)
#   - 3440x1440@165  (Ultrawide QHD, 165Hz)
#   - 3840x2160@60   (4K, 60Hz)
#
# Use 'preferred' to auto-detect the best resolution
# Use 'auto' for position to auto-arrange monitors
# =====================================================

# =====================================================
# For dual/multi-monitor setup:
# =====================================================
# See examples in:
#   - examples/monitors.conf.dual     (Dual monitor examples)
#   - examples/monitors.conf.all-examples (All examples)
# =====================================================
