// Minimal Niri configuration for the DMS session.
// DMS itself is started by the native NixOS systemd module.

environment {
    XDG_CURRENT_DESKTOP "niri"
    QT_QPA_PLATFORM "wayland"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    QT_QPA_PLATFORMTHEME "gtk3"
    QT_QPA_PLATFORMTHEME_QT6 "gtk3"
}

// Keep the current physical monitor arrangement used by Hyprland.
output "DP-6" {
    mode "3440x1440@165"
    position x=0 y=0
    scale 1
}

output "HDMI-A-2" {
    mode "1920x1080@60"
    transform "270"
    position x=-1080 y=0
    scale 1
}

prefer-no-csd

// Niri normally starts graphical-session.target, so only start Fcitx here.
spawn-sh-at-startup "pgrep -u \"$USER\" -x fcitx5 >/dev/null || exec fcitx5 -d"

// DMS Include Configs
include "dms/cursor.kdl"
include "dms/layout.kdl"
include "tab-indicator.kdl"
include "dms/alttab.kdl"
include "dms/binds.kdl"
include "dms/outputs.kdl"
include "dms/windowrules.kdl"
