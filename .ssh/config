# ~/.ssh/config (dotfiles 管理 / macOS)
#
# このリポジトリは公開されているため、ホスト名・IP・ポートなどの接続先は
# ここに書かない。非公開の接続先は ~/.ssh/config.d/private に置き、
# 原本は 1Password のセキュアノートで管理する (docs/macos-setup.md 参照)。

# OrbStack の Linux マシン用。Host ブロックより前に置く必要がある
# (ここにあれば OrbStack が ~/.ssh/config に追記しなくなる)
Include ~/.orbstack/ssh/config

# 非公開の接続先 (Host ブロックは最初に一致した値が優先されるため Host * より前)
Include ~/.ssh/config.d/*

Host *
  # 鍵は 1Password の SSH agent から使う。ホストごとに鍵を指定する場合は
  # IdentityFile に公開鍵 (~/.ssh/<name>.pub) を指定する
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
