{
  "$schema": "https://github.com/glzr-io/zebar/raw/v3.1.1/resources/zpack-schema.json",
  "name": "custom-paix",
  "version": "1.0.0",
  "description": "Dark themed paix-style bar for GlazeWM",
  "tags": [],
  "previewImages": [],
  "repositoryUrl": "",
  "widgets": [
    {
      "name": "dark-bar",
      "htmlPath": "./index.html",
      "presets": [
        {
          "name": "default",
          "anchor": "center_top",
          "offset_x": "0px",
          "offset_y": "10px",
          "width": "100%",
          "height": "34px",
          "z_order": "always_on_top",
          "transparent": true,
          "monitor_selection": "primary"
        }
      ]
    }
  ]
}