{
  "mcpServers": {
    "Context7": {
      "command": "npx.cmd",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "sequential-thinking": {
      "command": "npx.cmd",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "ddg-search": {
      "command": "uvx.exe",
      "args": [
        "duckduckgo-mcp-server"
      ]
    },
    "git": {
      "command": "uvx.exe",
      "args": [
        "mcp-server-git"
      ]
    },
    "mcp-deepwiki": {
      "command": "npx.cmd",
      "args": [
        "-y",
        "mcp-deepwiki@latest"
      ]
    },
    "memory": {
      "command": "npx.cmd",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "playwright": {
      "command": "npx.cmd",
      "args": [
        "@playwright/mcp@latest"
      ]
    }
  }
}